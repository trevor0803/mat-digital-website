{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh scripts/vercel-project-build.sh",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/estimate",
      "has": [{ "type": "host", "value": "kcnconstruction.com" }],
      "destination": "https://get.kcnconstruction.com",
      "permanent": false
    },
    {
      "source": "/estimate",
      "has": [{ "type": "host", "value": "www.kcnconstruction.com" }],
      "destination": "https://get.kcnconstruction.com",
      "permanent": false
    },
    {
      "source": "/estimate",
      "has": [{ "type": "host", "value": "kcn-construction-dmv.vercel.app" }],
      "destination": "https://get.kcnconstruction.com",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
